generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  isAdmin      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model RoverState {
  id           String   @id @default(cuid())
  batteryLevel Float
  positionLat  Float
  positionLon  Float
  connectivity String
  createdAt    DateTime @default(now())
}

model SensorReading {
  id             String   @id @default(cuid())
  distanceMeters Float
  lidarPoints    Int
  radarContacts  Int
  temperature    Float
  createdAt      DateTime @default(now())
}

model VideoStream {
  id        String   @id @default(cuid())
  name      String
  url       String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Command {
  id        String   @id @default(cuid())
  command   String
  speed     Float?
  userId    String?
  createdAt DateTime @default(now())
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
