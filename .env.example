# Local On-Edge Database (PostgreSQL 17)
DATABASE_URL="postgresql://user:password@localhost:5432/mar_db?sslmode=disable"

# Local Redis Cache & Broker
REDIS_URL="redis://localhost:6379"

# Local S3 Object Storage (MinIO)
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="mar-storage"
S3_ACCESS_KEY="your-s3-access-key"
S3_SECRET_KEY="your-s3-secret-key"

# JWT Secret
JWT_SECRET="your-jwt-secret-here"

# Port
PORT=3000
